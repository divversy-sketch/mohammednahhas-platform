{
  "name": "nahhas-new",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "quality:check": "npm run build && npm audit --audit-level=moderate",
    "deploy:rules": "firebase deploy --only firestore:rules",
    "deploy:hosting": "firebase deploy --only hosting",
    "deploy:functions": "firebase deploy --only functions",
    "security:smoke": "node scripts/security-smoke-check.mjs",
    "app:qa": "npm run source:health && npm run build && npm run security:smoke && npm audit --audit-level=moderate",
    "release:tag": "git tag v1.0.0-stable && git push origin v1.0.0-stable",
    "bundle:report": "node scripts/bundle-report.mjs",
    "production:check": "npm run source:health && npm run build && npm run security:smoke && npm run e2e:smoke && npm run bundle:report",
    "source:health": "node scripts/source-health-check.mjs",
    "migrate:plan": "node scripts/migrations/normalize-platform-data.mjs",
    "e2e:smoke": "node scripts/e2e-smoke.mjs",
    "postdeploy:qa": "node scripts/post-deploy-qa.mjs",
    "cleanup:report": "node scripts/cleanup-report.mjs",
    "firestore:performance": "node scripts/firestore-performance-audit.mjs",
    "backup:plan": "node scripts/backup-export-plan.mjs",
    "e2e:real": "node scripts/e2e-real-smoke.mjs",
    "production:ready": "npm run source:health && npm run cleanup:report && npm run firestore:performance && npm run e2e:smoke && npm run e2e:real && npm run backup:plan && npm run postdeploy:qa && npm run build && npm run security:smoke && npm run bundle:report",
    "e2e:playwright": "playwright test",
    "e2e:playwright:report": "playwright show-report",
    "v2:final-check": "node scripts/v2-final-check.mjs",
    "architecture:report": "node scripts/architecture-report.mjs",
    "architecture:guard": "node scripts/architecture-guard.mjs",
    "phase12:check": "npm run architecture:report && npm run architecture:guard && npm run source:health && npm run build",
    "quality:file-size": "node scripts/quality/file-size-guard.mjs",
    "quality:legacy-imports": "node scripts/quality/legacy-import-guard.mjs",
    "quality:barrels": "node scripts/quality/barrel-export-guard.mjs",
    "quality:summary": "node scripts/quality/architecture-summary.mjs",
    "test:architecture": "node --test tests/architecture/*.test.mjs",
    "final:check": "node scripts/quality/final-release-check.mjs",
    "test:unit": "node --test tests/unit/*.test.mjs",
    "test:security": "node --test tests/security/*.test.mjs",
    "test:all": "npm run test:unit && npm run test:architecture && npm run test:security",
    "security:env": "node scripts/security/env-guard.mjs",
    "security:audit": "node scripts/security/audit-report.mjs",
    "performance:budget": "node scripts/performance/bundle-budget-guard.mjs",
    "storybook:check": "node scripts/storybook/storybook-readiness-check.mjs",
    "final:ultimate": "npm run final:check && npm run test:all && npm run security:env && npm run security:audit && npm run performance:budget && npm run storybook:check"
  },
  "dependencies": {
    "@capacitor/cli": "^8.3.1",
    "@capacitor/core": "^8.3.1",
    "firebase": "^12.12.0",
    "framer-motion": "^12.38.0",
    "lucide-react": "^0.562.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "recharts": "^3.8.1",
    "firebase-admin": "^12.7.0",
    "jszip": "^3.10.1",
    "pdfjs-dist": "^4.10.38"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "vite": "^7.2.4",
    "@playwright/test": "^1.49.1"
  }
}
