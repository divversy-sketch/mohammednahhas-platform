{
  "name": "nahhas-new",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "quality:check": "npm run build && npm audit --audit-level=moderate",
    "deploy:rules": "firebase deploy --only firestore:rules",
    "deploy:hosting": "firebase deploy --only hosting",
    "deploy:functions": "firebase deploy --only functions",
    "security:smoke": "node scripts/security-smoke-check.mjs",
    "app:qa": "npm run source:health && npm run build && npm run security:smoke && npm audit --audit-level=moderate",
    "release:tag": "git tag v1.0.0-stable && git push origin v1.0.0-stable",
    "bundle:report": "node scripts/bundle-report.mjs",
    "production:check": "npm run app:qa && npm run bundle:report",
    "source:health": "node scripts/source-health-check.mjs"
  },
  "dependencies": {
    "@capacitor/cli": "^8.3.1",
    "@capacitor/core": "^8.3.1",
    "@tailwindcss/postcss": "^4.1.18",
    "firebase": "^12.12.0",
    "framer-motion": "^12.38.0",
    "lucide-react": "^0.562.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "recharts": "^3.8.1",
    "firebase-admin": "^12.7.0",
    "jszip": "^3.10.1",
    "pdfjs-dist": "^4.10.38"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "autoprefixer": "^10.4.23",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.18",
    "vite": "^7.2.4"
  }
}
