# Firebase client config
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Owner bootstrap for the frontend only. Firestore rules still require deployed rules/admin docs.
VITE_OWNER_EMAIL=

# Cloudinary unsigned upload preset. Keep the preset restricted, or replace with signed server upload for production.
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=

# Vercel / server API Firebase Admin config
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Cloud Functions AI correction
GEMINI_API_KEY=
GOOGLE_AI_API_KEY=
# Cloudinary signed upload - server only on Vercel/API runtime
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional browser-side values. Leave unsigned fallback false in production.
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_SIGNATURE_ENDPOINT=/api/cloudinary-signature
VITE_CLOUDINARY_ALLOW_UNSIGNED_FALLBACK=false

