{
  "rules": {
    ".read": false,
    ".write": false,

    "admins": {
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || root.child('admins').child(auth.uid).child('active').val() === true && root.child('admins').child(auth.uid).child('role').val() === 'admin')",
        ".write": "auth != null && root.child('admins').child(auth.uid).child('active').val() === true && root.child('admins').child(auth.uid).child('role').val() === 'admin' && (root.child('admins').child(auth.uid).child('adminRole').val() === 'owner' || root.child('admins').child(auth.uid).child('permissions').hasChildren(['all']))"
      }
    },

    "users": {
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || root.child('admins').child(auth.uid).child('active').val() === true && root.child('admins').child(auth.uid).child('role').val() === 'admin')",
        ".write": "auth != null && (root.child('admins').child(auth.uid).child('active').val() === true && root.child('admins').child(auth.uid).child('role').val() === 'admin' && (root.child('admins').child(auth.uid).child('permissions').hasChildren(['all']) || root.child('admins').child(auth.uid).child('permissions').hasChildren(['manage_users'])))"
      }
    },

    "student_presence": {
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || root.child('admins').child(auth.uid).child('active').val() === true && root.child('admins').child(auth.uid).child('role').val() === 'admin')",
        ".write": "auth != null && auth.uid === $uid"
      }
    },

    "exam_autosave": {
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || root.child('admins').child(auth.uid).child('active').val() === true && root.child('admins').child(auth.uid).child('role').val() === 'admin')",
        ".write": "auth != null && auth.uid === $uid"
      }
    },

    "admin_only": {
      ".read": "auth != null && (root.child('admins').child(auth.uid).child('active').val() === true && root.child('admins').child(auth.uid).child('role').val() === 'admin')",
      ".write": "auth != null && root.child('admins').child(auth.uid).child('active').val() === true && root.child('admins').child(auth.uid).child('role').val() === 'admin' && (root.child('admins').child(auth.uid).child('adminRole').val() === 'owner' || root.child('admins').child(auth.uid).child('permissions').hasChildren(['all']))"
    }
  }
}
