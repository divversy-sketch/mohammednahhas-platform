rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && request.auth.token.email != null
        && request.auth.token.email == 'mido16280@gmail.com';
    }

    function validSmallFile() {
      return request.resource.size < 10 * 1024 * 1024;
    }

    match /public/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin() && validSmallFile();
    }

    match /content/{allPaths=**} {
      allow read: if signedIn();
      allow write: if isAdmin() && validSmallFile();
    }

    match /users/{userId}/{allPaths=**} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == userId);
      allow write: if signedIn() && request.auth.uid == userId && validSmallFile();
      allow delete: if isAdmin() || (signedIn() && request.auth.uid == userId);
    }

    match /admin/{allPaths=**} {
      allow read, write: if isAdmin() && validSmallFile();
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
