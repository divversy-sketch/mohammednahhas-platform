rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function adminEmail() {
      return signedIn() && request.auth.token.email == 'mido16280@gmail.com';
    }

    function adminDoc() {
      return signedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.active == true
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role == 'admin';
    }

    function isAdmin() {
      return adminEmail() || adminDoc();
    }

    function ownerAdmin() {
      return adminEmail();
    }

    function adminPermissions() {
      return adminEmail()
        ? ['all']
        : (adminDoc() && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.permissions is list
          ? get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.permissions
          : []);
    }

    function hasAdminPermission(permission) {
      return adminEmail() || adminPermissions().hasAny(['all', permission]);
    }

    function canManageUsers() { return hasAdminPermission('manage_users'); }
    function canReadUsers() { return isAdmin(); }
    function canManageExams() { return hasAdminPermission('manage_exams') || hasAdminPermission('manage_exam_results'); }
    function canManageContent() { return hasAdminPermission('manage_content') || hasAdminPermission('manage_courses'); }
    function canManageHomework() { return hasAdminPermission('manage_homework'); }
    function canManageSubscriptions() { return hasAdminPermission('manage_subscriptions') || hasAdminPermission('manage_payments'); }
    function canManageMessages() { return hasAdminPermission('manage_messages') || hasAdminPermission('manage_notifications'); }
    function canManageSettings() { return hasAdminPermission('manage_settings'); }
    function canManageQuestionBank() { return hasAdminPermission('manage_question_bank') || hasAdminPermission('manage_exams'); }
    function canManageSecurity() { return hasAdminPermission('manage_security') || hasAdminPermission('manage_exams'); }


    function isPublicTarget() {
      return resource.data.target == 'all' || resource.data.targetType == 'all' || resource.data.grade == 'all';
    }

    function isGradeTarget() {
      return signedIn()
        && (resource.data.target == 'grade' || resource.data.targetType == 'grade')
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && (
          resource.data.grade == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.grade
          || resource.data.targetGrade == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.grade
        );
    }

    function isUserTarget() {
      return signedIn()
        && (
          resource.data.userId == request.auth.uid
          || resource.data.studentId == request.auth.uid
          || resource.data.targetUserId == request.auth.uid
        );
    }

    function canReadTargetedDocument() {
      return isAdmin() || isPublicTarget() || isGradeTarget() || isUserTarget();
    }

    function changesAdminRoleFields() {
      return request.resource.data.diff(resource.data).changedKeys().hasAny([
        'role', 'isAdmin', 'adminRole', 'adminRoleLabel', 'permissions', 'allowedTabs',
        'active', 'sourceUserId', 'roleUpdatedAt', 'roleUpdatedBy', 'roleRevokedAt', 'roleRevokedBy'
      ]);
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function ownUserIdOnCreate() {
      return signedIn()
        && request.resource.data.userId == request.auth.uid;
    }

    function ownStudentIdOnCreate() {
      return signedIn()
        && request.resource.data.studentId == request.auth.uid;
    }

    function ownsExistingUserId() {
      return signedIn()
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == resource.data.userId;
    }

    function ownsExistingStudentId() {
      return signedIn()
        && resource.data.studentId == request.auth.uid
        && request.resource.data.studentId == resource.data.studentId;
    }

    function safeStudentExamResultUpdate() {
      let changed = request.resource.data.diff(resource.data).changedKeys();
      return ownsExistingStudentId()
        && changed.hasOnly([
          'answers', 'answerText', 'essayAnswer', 'uploadedAnswerUrl', 'uploadedImages',
          'localDraftSyncedAt', 'autosaveAt', 'lastSavedAt', 'updatedAt', 'submittedAt',
          'status', 'timeLeft', 'remainingSeconds', 'remainingTime', 'currentQIndex',
          'antiCheatWarnings', 'antiCheatLog', 'studentNotes',
          'adminDecision', 'adminSecurityAction', 'resumeApproved',
          'resumedAfterAdminApprovalAt', 'restartedByAdminDecisionAt', 'sourceVideoId'
        ])
        && (!changed.hasAny(['adminDecision'])
          || (resource.data.adminDecision == 'continue' && request.resource.data.adminDecision == 'continue_consumed')
          || (resource.data.adminDecision == 'restart' && request.resource.data.adminDecision == 'restart_consumed'))
        && (!changed.hasAny(['adminSecurityAction'])
          || (resource.data.adminSecurityAction == 'continue' && request.resource.data.adminSecurityAction == 'continue_consumed')
          || (resource.data.adminSecurityAction == 'restart' && request.resource.data.adminSecurityAction == 'restart_consumed'))
        && (!changed.hasAny(['resumeApproved']) || request.resource.data.resumeApproved == false)
        && (!changed.hasAny(['score']) || request.resource.data.score == resource.data.score)
        && (!changed.hasAny(['totalScore']) || request.resource.data.totalScore == resource.data.totalScore)
        && (!changed.hasAny(['percentage']) || request.resource.data.percentage == resource.data.percentage)
        && (!changed.hasAny(['grade']) || request.resource.data.grade == resource.data.grade);
    }

    function safeOwnerProgressUpdate() {
      return ownsExistingUserId()
        && request.resource.data.diff(resource.data).changedKeys().hasOnly([
          'progress', 'completed', 'completedLessons', 'watchedSeconds', 'lastPosition',
          'notes', 'updatedAt', 'lastUpdatedAt', 'finishedAt', 'timeSpent', 'answers',
          'status', 'score', 'totalScore'
        ]);
    }

    match /admins/{adminId} {
      allow read: if isAdmin();
      allow create, update, delete: if ownerAdmin();
    }

    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId)
        && request.resource.data.role == 'student'
        && request.resource.data.status in ['pending', 'active'];
      allow update: if ownerAdmin()
        || (canManageUsers() && !changesAdminRoleFields())
        || (isOwner(userId)
          && request.resource.data.diff(resource.data).changedKeys().hasOnly([
            'name', 'phone', 'parentPhone', 'grade', 'photoURL', 'updatedAt',
            'lastLoginAt', 'deviceInfo', 'notificationToken', 'requestedGrade', 'gradeUpdateStatus'
          ])
          && request.resource.data.role == resource.data.role
          && request.resource.data.status == resource.data.status
          && request.resource.data.subscriptionStatus == resource.data.subscriptionStatus);
      allow delete: if canManageUsers();
    }

    match /content/{docId} {
      allow read: if true;
      allow write: if canManageContent();
    }

    match /settings/{docId} {
      allow read: if true;
      allow write: if canManageSettings();
    }

    match /exams/{docId} {
      allow read: if signedIn();
      allow write: if canManageExams();
    }

    match /exam_settings/{docId} {
      allow read: if signedIn();
      allow write: if canManageExams();
    }

    match /announcements/{docId} {
      allow read: if signedIn();
      allow write: if canManageMessages();
    }

    match /quotes/{docId} {
      allow read: if signedIn();
      allow write: if canManageMessages();
    }

    match /auto_replies/{docId} {
      allow read: if signedIn();
      allow write: if canManageMessages();
    }

    match /exam_access_overrides/{docId} {
      allow read: if isAdmin() || (signedIn() && resource.data.studentId == request.auth.uid);
      allow create, update, delete: if canManageExams();
    }

    match /exam_results/{docId} {
      allow read: if isAdmin() || (signedIn() && resource.data.studentId == request.auth.uid);
      allow create: if ownStudentIdOnCreate();
      allow update: if canManageExams() || safeStudentExamResultUpdate();
      allow delete: if canManageExams();
    }

    match /attempts/{docId} {
      allow read: if isAdmin() || (signedIn() && resource.data.userId == request.auth.uid);
      allow create: if ownUserIdOnCreate();
      allow update: if isAdmin() || safeOwnerProgressUpdate();
      allow delete: if canManageExams();
    }

    match /student_mistakes/{docId} {
      allow read: if isAdmin() || (signedIn() && resource.data.userId == request.auth.uid);
      allow create: if ownUserIdOnCreate();
      allow update, delete: if canManageQuestionBank();
    }

    match /smart_homeworks/{docId} {
      allow read: if signedIn();
      allow write: if canManageHomework();

      match /private/{privateDocId} {
        allow read, write: if canManageHomework();
      }
    }

    match /homework_results/{docId} {
      allow read: if isAdmin() || (signedIn() && resource.data.studentId == request.auth.uid);
      // نتائج واجب QR تكتب من Cloud Function فقط حتى لا يرى الطالب نموذج الإجابة ولا يزوّر الدرجة.
      allow create, update, delete: if canManageHomework();
    }

    match /assignments/{docId} {
      allow read: if signedIn();
      allow write: if canManageHomework();
    }

    match /assignment_submissions/{docId} {
      allow read: if isAdmin() || (signedIn() && resource.data.studentId == request.auth.uid);
      allow create: if ownStudentIdOnCreate();
      allow update: if canManageHomework() || safeStudentExamResultUpdate();
      allow delete: if canManageHomework();
    }

    match /video_views/{docId} {
      allow read: if isAdmin() || (signedIn() && resource.data.userId == request.auth.uid);
      allow create: if ownUserIdOnCreate();
      allow update: if isAdmin() || safeOwnerProgressUpdate();
      allow delete: if canManageExams();
    }

    match /video_notes/{docId} {
      allow read: if isAdmin() || (signedIn() && resource.data.userId == request.auth.uid);
      allow create: if ownUserIdOnCreate();
      allow update, delete: if isAdmin() || ownsExistingUserId();
    }

    match /question_bank/{docId} {
      allow read: if isAdmin();
      allow write: if canManageQuestionBank();
    }

    match /lesson_explanations/{docId} {
      allow read: if signedIn();
      allow write: if canManageContent();
    }

    match /subscription_codes/{docId} {
      allow read: if signedIn();
      allow create, delete: if canManageSubscriptions();
      allow update: if canManageSubscriptions()
        || (signedIn()
          && ((resource.data.isUsed == false && request.resource.data.isUsed == true)
              || (resource.data.used == false && request.resource.data.used == true))
          && (request.resource.data.usedBy == request.auth.uid || request.resource.data.usedById == request.auth.uid)
          && request.resource.data.diff(resource.data).changedKeys().hasOnly(['isUsed', 'used', 'usedBy', 'usedById', 'usedAt', 'updatedAt']));
    }

    match /courseAccessCodes/{codeId} {
      allow read: if signedIn();
      allow create, delete: if canManageSubscriptions();
      allow update: if canManageSubscriptions()
        || (signedIn()
          && resource.data.isUsed == false
          && request.resource.data.isUsed == true
          && request.resource.data.usedBy == request.auth.uid
          && request.resource.data.diff(resource.data).changedKeys().hasOnly(['isUsed', 'usedBy', 'usedAt', 'updatedAt']));
    }

    match /banned_users/{docId} {
      allow read: if isAdmin();
      allow write: if canManageSecurity() || canManageUsers();
    }

    match /notifications/{docId} {
      allow read: if canReadTargetedDocument();
      allow write: if canManageMessages();
    }

    match /student_groups/{groupId} {
      allow read: if isAdmin() || signedIn();
      allow write: if canManageUsers();
    }

    match /student_messages/{messageId} {
      allow read: if canReadTargetedDocument();
      allow create: if canManageMessages() || (signedIn() && request.resource.data.userId == request.auth.uid && request.resource.data.kind == 'support');
      allow update, delete: if canManageMessages();
    }


    match /live_classes/{classId} {
      allow read: if signedIn();
      allow create, update, delete: if canManageContent();
    }

    match /certificates/{certificateId} {
      allow read: if isAdmin() || (signedIn() && resource.data.userId == request.auth.uid);
      allow create: if isAdmin() || (signedIn() && request.resource.data.userId == request.auth.uid);
      allow update, delete: if canManageUsers() || canManageExams();
    }

    match /notification_tokens/{docId} {
      allow read: if isAdmin();
      allow create, update: if ownUserIdOnCreate();
      allow delete: if canManageMessages() || (signedIn() && resource.data.userId == request.auth.uid);
    }

    match /messages/{docId} {
      allow create: if true;
      allow read: if isAdmin();
      allow update, delete: if canManageMessages();
    }

    match /student_chats/{studentId} {
      allow read: if isAdmin() || isOwner(studentId);
      allow create, update: if canManageMessages() || isOwner(studentId);
      allow delete: if canManageMessages();

      match /messages/{messageId} {
        allow read: if isAdmin() || isOwner(studentId);
        allow create: if canManageMessages() || isOwner(studentId);
        allow update, delete: if canManageMessages();
      }
    }

    match /password_reset_requests/{docId} {
      // الطالب غير مسجل دخول عند نسيان كلمة السر، لذلك نسمح بإنشاء طلب فقط.
      // القراءة/المراجعة/الحذف للأدمن فقط، وتغيير كلمة السر الفعلي يتم من Cloud Function.
      allow create: if request.resource.data.email is string
        && request.resource.data.status == 'pending'
        && request.resource.data.keys().hasOnly(['email', 'name', 'status', 'source', 'createdAt', 'updatedAt']);
      allow read: if isAdmin();
      allow update, delete: if canManageUsers() || canManageMessages();
    }

    match /payment_requests/{docId} {
      allow read: if isAdmin() || (signedIn() && resource.data.userId == request.auth.uid);
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'pending';
      allow update, delete: if canManageSubscriptions();
    }

    match /debug_logs/{docId} {
      allow create: if signedIn();
      allow read: if isAdmin();
      allow update, delete: if canManageSecurity();
    }

    match /system_errors/{docId} {
      allow create: if signedIn();
      allow read: if isAdmin();
      allow update, delete: if canManageSecurity();
    }

    match /performance_metrics/{docId} {
      allow create: if signedIn();
      allow read: if isAdmin();
      allow update, delete: if canManageSecurity();
    }

    match /migration_reports/{docId} {
      allow read: if isAdmin();
      allow write: if canManageSecurity();
    }

    match /admin_audit_logs/{docId} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }

    match /admin_client_logs/{docId} {
      allow read, create: if isAdmin();
      allow update, delete: if false;
    }

    match /platform_settings/{docId} {
      allow read: if true;
      allow write: if canManageSettings();
    }

    match /courses/{courseId} {
      allow read: if signedIn();
      allow write: if canManageContent();

      match /modules/{moduleId} {
        allow read: if signedIn();
        allow write: if canManageContent();

        match /lessons/{lessonId} {
          allow read: if signedIn();
          allow write: if canManageContent();
        }
      }
    }

    match /enrollments/{enrollmentId} {
      allow read: if isAdmin() || (signedIn() && resource.data.userId == request.auth.uid);
      allow create: if isAdmin() || ownUserIdOnCreate();
      allow update: if isAdmin() || safeOwnerProgressUpdate();
      allow delete: if canManageExams();
    }

    match /lessonProgress/{progressId} {
      allow read: if isAdmin() || (signedIn() && resource.data.userId == request.auth.uid);
      allow create: if ownUserIdOnCreate();
      allow update: if isAdmin() || safeOwnerProgressUpdate();
      allow delete: if canManageExams();
    }

    match /lessonUnlockOverrides/{overrideId} {
      allow read: if isAdmin() || (signedIn() && resource.data.userId == request.auth.uid);
      allow write: if canManageContent();
    }

    match /examResults/{resultId} {
      allow read: if isAdmin() || (signedIn() && resource.data.userId == request.auth.uid);
      allow create: if ownUserIdOnCreate();
      allow update: if isAdmin() || safeOwnerProgressUpdate();
      allow delete: if canManageExams();
    }

    // Features removed from the cleaned platform: keep blocked unless you re-enable them intentionally.
    match /live_sessions/{document=**} { allow read, write: if false; }
    match /live_attendance/{document=**} { allow read, write: if false; }
    match /ai_usage/{document=**} { allow read, write: if false; }
    match /ai_exam_results/{document=**} { allow read, write: if false; }
    match /ai_generated_exams/{document=**} { allow read, write: if false; }
    match /rafiq_lessons/{document=**} { allow read, write: if false; }
    match /rafiq_questions/{document=**} { allow read, write: if false; }
    match /rafiq_question_bank/{document=**} { allow read, write: if false; }
    match /rafiq_unanswered_questions/{document=**} { allow read, write: if false; }
    match /rafiq_answered_questions/{document=**} { allow read, write: if false; }
    match /rafiq_interactions/{document=**} { allow read, write: if false; }
    match /rafiq_student_weak_points/{document=**} { allow read, write: if false; }
    match /student_questions_log/{document=**} { allow read, write: if false; }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
